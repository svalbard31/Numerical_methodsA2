import numpy as np
import cv2
from matplotlib import pyplot as plt


img = cv2.imread("image0.jpg") #Read image
grey = cv2.cvtColor(img, cv2.COLOR_RGB2GRAY)/255 #Turn it from [0,255] to [0,1] and into grayscale

def svd(image):
    u, s, v = np.linalg.svd(image) #SVD decomposition
    return u, s, v

def truncate(u,s,v,k):
    u_k=u[:,:k] #Take the first k columns of u
    s_k=np.diag(s[:k]) #Take the first k singular values and make a diagonal matrix
    v_k=v[:k,:] #Take the first k rows of v 
    return u_k, s_k, v_k

def create_img(u,s,v):
    return np.matmul(u, np.matmul(s, v)) #Recreate the image from the SVD decomposition


fig = plt.figure(figsize=(10, 10))



plt.subplot(3,2,1)
plt.imshow(create_img(*truncate(*svd(grey), 5)), cmap='gray', interpolation='nearest')
plt.title("k=5")


plt.subplot(3,2,2)
plt.imshow(create_img(*truncate(*svd(grey), 15)), cmap='gray', interpolation='nearest')
plt.title("k=15")


plt.subplot(3,2,3)
plt.imshow(create_img(*truncate(*svd(grey), 50)), cmap='gray', interpolation='nearest')
plt.title("k=50")


plt.subplot(3,2,4)
plt.imshow(create_img(*truncate(*svd(grey), 200)), cmap='gray', interpolation='nearest')
plt.title("k=200")


plt.subplot(3,2,5)
plt.imshow(grey, cmap='gray', interpolation='nearest')
plt.title("Original")


plt.show()
